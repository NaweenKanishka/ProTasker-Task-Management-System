    private void find_Click(object sender, EventArgs e)
    {
        string keyword = guna2TextBox1.Text.Trim(); // Get text from your input field

        if (string.IsNullOrEmpty(keyword))
        {
            MessageBox.Show("Please enter a task name or due date to search.");
            return;
        }

        guna2DataGridView1.Rows.Clear(); // Clear existing rows

        try
        {
            using (MySqlConnection conn = new MySqlConnection(connectionString))
            {
                conn.Open();
                string query = @"SELECT tid, task_name, t_description, start_date, due_date, priority 
                         FROM tasks 
                         WHERE task_name LIKE @keyword OR due_date LIKE @keyword";

                MySqlCommand cmd = new MySqlCommand(query, conn);
                cmd.Parameters.AddWithValue("@keyword", "%" + keyword + "%");

                MySqlDataReader reader = cmd.ExecuteReader();

                // Load image icons again
                Image editIcon = new Bitmap(Image.FromFile("pen.png"), new Size(24, 24));
                Image deleteIcon = new Bitmap(Image.FromFile("check.png"), new Size(24, 24));

                while (reader.Read())
                {
                    string id = reader["tid"].ToString();
                    string taskName = reader["task_name"].ToString();
                    string description = reader["t_description"].ToString();
                    string startDate = Convert.ToDateTime(reader["start_date"]).ToString("yyyy-MM-dd");
                    string dueDate = Convert.ToDateTime(reader["due_date"]).ToString("yyyy-MM-dd");
                    string priority = reader["priority"].ToString();

                    int rowIndex = guna2DataGridView1.Rows.Add(id, taskName, description, startDate, dueDate, priority);
                    guna2DataGridView1.Rows[rowIndex].Cells["Edit"].Value = editIcon;
                    guna2DataGridView1.Rows[rowIndex].Cells["Done"].Value = deleteIcon;

                    // Apply color styles based on priority
                    switch (priority.ToLower())
                    {
                        case "high":
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.BackColor = Color.FromArgb(204, 153, 255);
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.ForeColor = Color.White;
                            break;
                        case "medium":
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.BackColor = Color.FromArgb(255, 204, 102);
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.ForeColor = Color.Black;
                            break;
                        case "low":
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.BackColor = Color.FromArgb(153, 255, 153);
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.ForeColor = Color.Black;
                            break;
                        default:
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.BackColor = Color.White;
                            guna2DataGridView1.Rows[rowIndex].DefaultCellStyle.ForeColor = Color.Black;
                            break;
                    }
                }

                reader.Close();
            }
        }
        catch (Exception ex)
        {
            MessageBox.Show("Error: " + ex.Message);
        }
    }
